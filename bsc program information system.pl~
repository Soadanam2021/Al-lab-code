% Get all details of a course by its code
get_course_details(CourseCode, CourseName, TeacherName, Credit, SemesterYear) :-
    course(CourseCode, CourseName, TeacherName, Credit, SemesterYear).

% Get all courses taught by a given TeacherName
get_courses_by_teacher(TeacherName, CourseList) :-
    findall(
       [Code, Name, Credit, SemYear],
       course(Code, Name, TeacherName, Credit, SemYear),
       CourseList
    ).
